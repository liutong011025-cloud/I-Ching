# Dify reading API. Set these on the server / in Vercel Environment Variables.
# Never use NEXT_PUBLIC_ for a new secret. The server still accepts legacy
# NEXT_PUBLIC_DIFY_API_KEY and NEXT_PUBLIC_DIFY_API_BASE for existing deployments.
DIFY_API_KEY=
# DIFY_API_BASE=https://api.dify.ai/v1
# The text model is configured in your Dify application, not in this project.

# Volcengine ModelArk image generation, server only.
ARK_API_KEY=
# ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# SEEDREAM_MODEL_ID=doubao-seedream-5-0-lite-260128
# Without an override: Seedream 5.0 lite, then 5.0, then 4.0.
# Fallback happens only for a model that is unavailable or not activated.

# Store real values in an untracked .env.local file. Rotate keys previously
# committed to Git or exposed in a browser bundle. After migration, remove the
# legacy public names from Vercel and use DIFY_API_KEY / DIFY_API_BASE instead.
